{
  "name": "forms",
  "version": "1.2.0",
  "private": true,
  "description": "OpenCloud Forms: forms as a native OpenCloud file type",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "vite build",
    "build:w": "vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,vue}' 'server/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "vitest run",
    "test:server": "node --test 'server/**/*.test.ts'",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run check:types && npm run test:unit && npm run test:server && npm run build",
    "server": "node server/server.ts",
    "package": "npm run build && cd dist && zip -qrFS ../forms.zip . && cd .. && node scripts/package.mjs",
    "test:public": "node --test 'tests/public/**/*.test.ts'"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "^7.4.0",
    "@opencloud-eu/extension-sdk": "7.4.0",
    "@opencloud-eu/prettier-config": "^7.4.0",
    "@opencloud-eu/tsconfig": "^7.4.0",
    "@opencloud-eu/web-client": "^7.4.0",
    "@opencloud-eu/web-pkg": "^7.4.0",
    "@opencloud-eu/web-test-helpers": "^7.4.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.1.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.1",
    "vitest-mock-extended": "^5.0.0",
    "vue": "^3.5.13",
    "vue-tsc": "^3.2.6",
    "vue3-gettext": "4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JulesMellot/opencloud-forms.git"
  },
  "bugs": {
    "url": "https://github.com/JulesMellot/opencloud-forms/issues"
  },
  "homepage": "https://github.com/JulesMellot/opencloud-forms#readme"
}
